[Source33]
Name=IsGpuLimited
Units=
Format=%.0f
Formula=validate(msBetweenPresents) && (msBetweenPresents > 0) && ((msGpuActive / msBetweenPresents) >= 0.75)
Provider=HAL
ID=Stub

[Source34]
Name=IsCpuLimited
Units=
Format=%.0f
Formula=validate(msBetweenPresents) && (msBetweenPresents > 0) && ((CPUBusy / msBetweenPresents) >= 0.75)
Provider=HAL
ID=Stub

[Source35]
Name=IsPMIndFlip
